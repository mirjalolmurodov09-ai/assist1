<Window x:Class="ClassroomControl.StudentAgent.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Settings}"
        Width="520" Height="480" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">
            <TabItem Header="{DynamicResource Str.General}">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource Str.ComputerName}" />
                    <TextBox Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,4,0,10" Padding="3" />
                    <TextBlock Text="{DynamicResource Str.StudentName}" />
                    <TextBox Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,4,0,10" Padding="3" />
                    <TextBlock Text="{DynamicResource Str.ClassroomCode}" />
                    <TextBox Text="{Binding ClassroomCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,4,0,10" Padding="3" />
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="130" Text="{DynamicResource Str.Classroom}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ClassroomName}" Style="{StaticResource Value}" />
                    </DockPanel>
                    <CheckBox Content="{DynamicResource Str.StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Str.Network}">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource Str.TeacherIp}" />
                    <TextBox Text="{Binding TeacherAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" Margin="0,4,0,10" Padding="3" />
                    <TextBlock Text="{DynamicResource Str.TeacherPort}" />
                    <TextBox Text="{Binding TeacherPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="3" />
                    <TextBlock Text="{DynamicResource Str.DiscoveryPort}" />
                    <TextBox Text="{Binding DiscoveryPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="3" />
                    <TextBlock Text="{DynamicResource Str.ConnectionTimeout}" />
                    <TextBox Text="{Binding ConnectionTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="3" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Str.Security}">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource Str.DeviceId}" />
                    <TextBox Text="{Binding DeviceId, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10" Padding="3" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{DynamicResource Str.RegistrationStatus}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding RegistrationStatus}" Style="{StaticResource Value}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="150" Text="{DynamicResource Str.CertificateStatus}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding CertificateStatus}" Style="{StaticResource Value}" TextWrapping="Wrap" />
                    </DockPanel>
                    <Button Content="{DynamicResource Str.ResetCertificate}" Command="{Binding ResetCertificateCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource Str.About}">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource Str.WindowTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{DynamicResource Str.Version}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource Value}" />
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{DynamicResource Str.Developer}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding DeveloperName}" Style="{StaticResource Value}" />
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{DynamicResource Str.Email}" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Email, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" />
                    </DockPanel>
                    <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Left" Width="90" Text="{DynamicResource Str.Telegram}" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Telegram, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" />
                    </DockPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Str.Save}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Str.Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
