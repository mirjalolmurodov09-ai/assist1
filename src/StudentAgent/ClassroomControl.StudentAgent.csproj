<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF and WinForms both define Application/MessageBox etc.; usings are explicit in this project. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ClassroomControl.StudentAgent</RootNamespace>
    <AssemblyName>ClassroomControl.StudentAgent</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\agent.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Description>Classroom Control - Student Agent</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StudentAgent.Core\ClassroomControl.StudentAgent.Core.csproj" />
    <ProjectReference Include="..\Shared\ClassroomControl.Shared.csproj" />
    <ProjectReference Include="..\Infrastructure\ClassroomControl.Infrastructure.csproj" />
    <ProjectReference Include="..\Platform\ClassroomControl.Platform.csproj" />
    <ProjectReference Include="..\Wpf\ClassroomControl.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Icons\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
