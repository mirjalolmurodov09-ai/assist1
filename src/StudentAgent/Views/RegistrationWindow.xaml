<Window x:Class="ClassroomControl.StudentAgent.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.RegistrationTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource Str.RegistrationTitle}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{DynamicResource Str.RegistrationHint}" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#555555" />

        <TextBlock Text="{DynamicResource Str.ClassroomCode}" />
        <TextBox Text="{Binding ClassroomCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="0,4,0,10" Padding="4" FontSize="16" />

        <TextBlock Text="{DynamicResource Str.StudentName}" />
        <TextBox Text="{Binding StudentName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,4,0,10" Padding="4" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B00020" TextWrapping="Wrap" MinHeight="18" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Str.Connect}" Command="{Binding ConnectCommand}" IsDefault="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Str.Close}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
