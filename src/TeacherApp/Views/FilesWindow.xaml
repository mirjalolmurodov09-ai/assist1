<Window Style="{DynamicResource {x:Type Window}}" x:Class="ClassroomControl.TeacherApp.Views.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Files.Title}" Width="860" Height="620" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Button Content="{l:Loc Files.SendSelected}" Command="{Binding SendToSelectedCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="{l:Loc Files.SendGroup}" Command="{Binding SendToGroupCommand}" />
            <Button Content="{l:Loc Files.SendAll}" Command="{Binding SendToAllCommand}" />
            <Button Content="{l:Loc Files.Cancel}" Command="{Binding CancelCommand}" />
            <Button Content="{l:Loc Files.ClearFinished}" Command="{Binding ClearFinishedCommand}" />
            <Button Content="{l:Loc Files.OpenFolder}" Command="{Binding OpenReceivedFolderCommand}" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Margin="0,6,0,10">
            <CheckBox Content="{l:Loc Files.AcceptFromStudents}" IsChecked="{Binding AcceptFromStudents}" Margin="0,2" />
            <CheckBox Content="{l:Loc Files.AllowPrograms}" IsChecked="{Binding AllowPrograms}" Margin="0,2" />
            <TextBlock Text="{l:Loc Files.AllowProgramsHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="22,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{l:Loc Files.MaxSize}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}" Width="70" />
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding FileName, Mode=OneWay}" /> <Run Text="{Binding SizeText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding DirectionText, Mode=OneWay}" /> · <Run Text="{Binding ComputerTitle, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding StatusText}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{l:Loc Files.Open}" Margin="0" Padding="8,3"
                                Command="{Binding OpenCommand}"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{l:Loc Files.Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" />
    </Grid>
</Window>
