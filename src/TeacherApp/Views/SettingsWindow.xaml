<Window Style="{DynamicResource {x:Type Window}}" x:Class="ClassroomControl.TeacherApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Settings.Title}" Width="880" Height="640" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">
            <!-- General -->
            <TabItem Header="{l:Loc Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{l:Loc Settings.ClassroomName}" />
                        <TextBox Text="{Binding ClassroomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" Margin="0,4,0,14" />
                        <TextBlock Text="{l:Loc Settings.ClassroomCode}" />
                        <TextBox Text="{Binding ClassroomCode, Mode=OneWay}" IsReadOnly="True" FontSize="22" FontWeight="Bold" BorderThickness="0" Background="Transparent" Margin="0,4,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="{l:Loc Settings.NewCode}" Command="{Binding RegenerateCodeCommand}" Margin="0,0,8,0" />
                            <Button Content="{l:Loc Settings.SetCode}" Command="{Binding SetCodeCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{l:Loc Settings.Language}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                            <Button Content="O‘zbekcha" Tag="uz" Click="Language_Click" Margin="0,0,8,0" />
                            <Button Content="English" Tag="en" Click="Language_Click" Margin="0,0,8,0" />
                            <Button Content="Русский" Tag="ru" Click="Language_Click" Margin="0" />
                        </StackPanel>
                        <CheckBox Content="{l:Loc Settings.Dark}" IsChecked="{Binding IsDarkTheme}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Network -->
            <TabItem Header="{l:Loc Tab.Network}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{l:Loc Settings.TcpPort}" />
                        <TextBox Text="{Binding TcpPort}" Margin="0,4,0,10" />
                        <TextBlock Text="{l:Loc Settings.DiscoveryPort}" />
                        <TextBox Text="{Binding DiscoveryPort}" Margin="0,4,0,10" />
                        <TextBlock Text="{l:Loc Settings.LocalAddresses}" />
                        <TextBox Text="{Binding LocalAddresses, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10" />
                        <TextBlock Text="{Binding FirewallHint}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Security -->
            <TabItem Header="{l:Loc Tab.Security}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox Content="{l:Loc Settings.RequireActive}" IsChecked="{Binding RequireAgentActive}" />
                        <TextBlock Text="{l:Loc Settings.AutoUnlock}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding AutoUnlockSeconds}" Margin="0,4,0,10" />
                        <TextBlock Text="{l:Loc Settings.Certificate}" />
                        <TextBox Text="{Binding CertificateFingerprint, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,4,0,14" />
                        <TextBlock Text="{l:Loc Settings.Users}" Style="{StaticResource Heading}" />
                        <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Height="130" Margin="0,6,0,6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Role}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastLogin}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="3" Text="⛔" Visibility="{Binding Disabled, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Loc User.Add}" Command="{Binding AddUserCommand}" Margin="0,0,8,0" />
                            <Button Content="{l:Loc User.Reset}" Command="{Binding ResetPasswordCommand}" Margin="0,0,8,0" />
                            <Button Content="{l:Loc User.Toggle}" Command="{Binding ToggleUserCommand}" Margin="0,0,8,0" />
                            <Button Content="{l:Loc User.Delete}" Command="{Binding DeleteUserCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Monitoring -->
            <TabItem Header="{l:Loc Tab.Monitoring}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{l:Loc Settings.MonitoringHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{l:Loc Settings.Fps}" />
                        <TextBox Text="{Binding MonitoringFps}" Margin="0,4,0,10" />
                        <TextBlock Text="{l:Loc Settings.Quality}" />
                        <TextBox Text="{Binding MonitoringQuality}" Margin="0,4,0,10" />
                        <TextBlock Text="{l:Loc Settings.Width}" />
                        <TextBox Text="{Binding MonitoringMaxWidth}" Margin="0,4,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Screen quality -->
            <TabItem Header="{l:Loc Tab.ScreenQuality}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{l:Loc Settings.FullScreen}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{l:Loc Settings.Fps}" Margin="0,6,0,0" />
                        <TextBox Text="{Binding FullScreenFps}" Margin="0,4,0,8" />
                        <TextBlock Text="{l:Loc Settings.Quality}" />
                        <TextBox Text="{Binding FullScreenQuality}" Margin="0,4,0,8" />
                        <TextBlock Text="{l:Loc Settings.Width}" />
                        <TextBox Text="{Binding FullScreenMaxWidth}" Margin="0,4,0,16" />
                        <TextBlock Text="{l:Loc Settings.TeacherScreen}" Style="{StaticResource Heading}" />
                        <TextBlock Text="{l:Loc Settings.Fps}" Margin="0,6,0,0" />
                        <TextBox Text="{Binding TeacherScreenFps}" Margin="0,4,0,8" />
                        <TextBlock Text="{l:Loc Settings.Quality}" />
                        <TextBox Text="{Binding TeacherScreenQuality}" Margin="0,4,0,8" />
                        <TextBlock Text="{l:Loc Settings.Width}" />
                        <TextBox Text="{Binding TeacherScreenMaxWidth}" Margin="0,4,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Groups -->
            <TabItem Header="{l:Loc Tab.Groups}">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:Loc Group.Add}" Command="{Binding AddGroupCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Group.Rename}" Command="{Binding RenameGroupCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Group.Delete}" Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Student agents -->
            <TabItem Header="{l:Loc Tab.Agents}">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{l:Loc Action.Rename}" Command="{Binding RenameAgentCommand}" Margin="0,0,8,0" />
                        <Button Content="{l:Loc Action.Remove}" Command="{Binding RemoveAgentCommand}" Style="{StaticResource DangerButton}" Margin="0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StudentName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding IpAddress}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="{l:Loc Tab.Logs}">
                <DockPanel Margin="16" DataContext="{Binding Logs}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="{l:Loc Logs.Refresh}" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc Logs.Time}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="{l:Loc Logs.Teacher}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="2" Text="{l:Loc Logs.Computer}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="3" Text="{l:Loc Logs.Action}" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="4" Text="{l:Loc Logs.Result}" Style="{StaticResource Muted}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Entries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Teacher}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Computer}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Result}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="2,8,2,0" MinHeight="18" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{l:Loc Common.Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{l:Loc Common.Close}" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
