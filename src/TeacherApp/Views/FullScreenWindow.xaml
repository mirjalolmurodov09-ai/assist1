<Window x:Class="ClassroomControl.TeacherApp.Views.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{Binding Title}" Width="1280" Height="800" WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKey" PreviewKeyUp="Window_PreviewKey">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Loc FS.Remote}" Command="{Binding ToggleRemoteCommand}" Margin="0,0,6,0" Focusable="False" />
                    <Button Content="{l:Loc Action.Lock}" Command="{Binding LockCommand}" Margin="0,0,6,0" Focusable="False" />
                    <Button Content="{l:Loc Action.Unlock}" Command="{Binding UnlockCommand}" Margin="0,0,6,0" Focusable="False" />
                    <Button Content="{l:Loc Action.Screenshot}" Command="{Binding ScreenshotCommand}" Margin="0,0,6,0" Focusable="False" />
                    <Button Content="{l:Loc FS.Close}" Click="Close_Click" Margin="0" Focusable="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Border Background="#B91C1C" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                            Visibility="{Binding RemoteActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:Loc FS.RemoteActive}" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource DangerBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource ThumbBgBrush}">
            <Image x:Name="ScreenImage" Source="{Binding Computer.Preview}" Stretch="Uniform"
                   MouseMove="Screen_MouseMove" MouseDown="Screen_MouseButton" MouseUp="Screen_MouseButton" MouseWheel="Screen_MouseWheel" />
        </Border>
    </Grid>
</Window>
