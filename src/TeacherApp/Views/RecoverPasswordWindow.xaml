<Window Style="{DynamicResource {x:Type Window}}" x:Class="ClassroomControl.TeacherApp.Views.RecoverPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Recover.Title}" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="26">
        <TextBlock Text="{l:Loc Recover.Title}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{l:Loc Recover.Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18" />
        <TextBlock Text="{l:Loc Recover.User}" />
        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" DisplayMemberPath="Username" Margin="0,4,0,10" />
        <TextBlock Text="{l:Loc Recover.NewPassword}" />
        <PasswordBox x:Name="Password" Margin="0,4,0,10" />
        <TextBlock Text="{l:Loc Setup.Confirm}" />
        <PasswordBox x:Name="Confirm" Margin="0,4,0,10" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Loc Common.Save}" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{l:Loc Common.Cancel}" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
