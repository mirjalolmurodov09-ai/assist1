<Window Style="{DynamicResource {x:Type Window}}" x:Class="ClassroomControl.TeacherApp.Views.SetupAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Setup.Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="26">
        <TextBlock Text="{l:Loc Setup.Title}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="{l:Loc Setup.Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,18" />
        <TextBlock Text="{l:Loc Login.User}" />
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />
        <TextBlock Text="{l:Loc Login.Password}" />
        <PasswordBox x:Name="Password" Margin="0,4,0,10" />
        <TextBlock Text="{l:Loc Setup.Confirm}" />
        <PasswordBox x:Name="Confirm" Margin="0,4,0,10" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Loc Setup.Create}" IsDefault="True" Click="Create_Click" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="{l:Loc Login.Exit}" IsCancel="True" MinWidth="90" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
