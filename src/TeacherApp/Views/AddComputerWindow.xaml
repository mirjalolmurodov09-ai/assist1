<Window Style="{DynamicResource {x:Type Window}}" x:Class="ClassroomControl.TeacherApp.Views.AddComputerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Add.Title}" Width="620" Height="520" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{l:Loc Add.Title}" FontSize="20" FontWeight="Bold" />
        <Border Grid.Row="1" Margin="0,12,0,12" Padding="14" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                <TextBox Text="{Binding ClassroomCode, Mode=OneWay}" IsReadOnly="True" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"
                         BorderThickness="0" Background="Transparent" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="{l:Loc Add.Pending}" Style="{StaticResource Heading}" Margin="0,0,0,6" />
            <ListBox ItemsSource="{Binding Pending}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ComputerName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StudentName}" />
                            <TextBlock Grid.Column="2" Text="{Binding IpAddress}" Style="{StaticResource Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:Loc Add.ApproveAll}" Command="{Binding ApproveAllCommand}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Action.Approve}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Action.Reject}" Command="{Binding RejectCommand}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Common.Close}" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
