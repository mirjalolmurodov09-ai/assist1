<Window x:Class="ClassroomControl.TeacherApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc App.Name}" Width="1440" Height="860" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="ComputerCard">
            <Border Width="224" Margin="6" Padding="8" CornerRadius="8" BorderThickness="2" Cursor="Hand"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Background="{DynamicResource ThumbBgBrush}" Height="116" CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding Preview}" Stretch="Uniform" />
                            <TextBlock Text="{l:Loc Card.NoPreview}" Foreground="#9AA4B5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                <TextBlock Text="🔒" Margin="2,0" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="🖱" Margin="2,0" Visibility="{Binding IsRemoteControlled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,8,0,0">
                        <Ellipse Width="10" Height="10" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource OfflineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource OnlineBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource PendingBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" DockPanel.Dock="Right" FontSize="11" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding StudentName}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding QualityText}" Style="{StaticResource Muted}" DockPanel.Dock="Right" FontSize="11" />
                        <TextBlock Text="{Binding IpAddress}" Style="{StaticResource Muted}" FontSize="11" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding PingText}" Style="{StaticResource Muted}" DockPanel.Dock="Right" FontSize="11" />
                        <TextBlock FontSize="11" Style="{StaticResource Muted}">
                            <Run Text="CPU" /> <Run Text="{Binding CpuText, Mode=OneWay}" />   <Run Text="RAM" /> <Run Text="{Binding RamText, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:Loc Top.LockAll}" Command="{Binding LockAllCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.UnlockAll}" Command="{Binding UnlockAllCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.MessageAll}" Command="{Binding MessageAllCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.ShareAll}" Command="{Binding ShareScreenAllCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.Monitoring}" Command="{Binding ToggleMonitoringCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.AddComputer}" Command="{Binding AddComputerCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.Screenshots}" Command="{Binding ScreenshotsCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.Settings}" Command="{Binding SettingsCommand}" Margin="0,0,6,0" />
                    <Button Content="{l:Loc Top.About}" Command="{Binding AboutCommand}" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc App.Name}" Style="{StaticResource Heading}" Margin="0,0,16,0" />
                    <TextBlock Text="{l:Loc Top.Classroom}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ClassroomName}" FontWeight="SemiBold" Margin="4,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Loc Top.Connected}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource OnlineBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OnlineCount}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource OfflineBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OfflineCount}" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Text="{l:Loc Top.Teacher}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TeacherUser}" FontWeight="SemiBold" Margin="4,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TeacherStatus}" Foreground="{DynamicResource OnlineBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- pending approval banner -->
        <Border Grid.Row="1" Background="{DynamicResource SelectionBrush}" Padding="14,6" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button Content="{l:Loc Banner.Review}" Command="{Binding AddComputerCommand}" DockPanel.Dock="Right" Margin="0" Padding="10,2" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="⏳" /> <Run Text="{Binding PendingCount, Mode=OneWay}" FontWeight="Bold" /> <Run Text="{l:Loc Banner.PendingText}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- groups -->
            <DockPanel Grid.Column="0" Margin="12,12,6,12">
                <TextBlock Text="{l:Loc Left.Groups}" Style="{StaticResource Heading}" DockPanel.Dock="Top" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- computers -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,6">
                <ItemsControl ItemsSource="{Binding Computers}" ItemTemplate="{StaticResource ComputerCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- actions -->
            <Border Grid.Column="2" Margin="6,12,12,12" Padding="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Right.Title}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                        <Button Content="{l:Loc Action.ViewScreen}" Command="{Binding ViewScreenCommand}" />
                        <Button Content="{l:Loc Action.RemoteControl}" Command="{Binding RemoteControlCommand}" />
                        <Button Content="{l:Loc Action.Lock}" Command="{Binding LockSelectedCommand}" />
                        <Button Content="{l:Loc Action.Unlock}" Command="{Binding UnlockSelectedCommand}" />
                        <Button Content="{l:Loc Action.Message}" Command="{Binding MessageSelectedCommand}" />
                        <Button Content="{l:Loc Action.Screenshot}" Command="{Binding ScreenshotCommand}" />
                        <Button Content="{l:Loc Action.ShareSelected}" Command="{Binding ShareScreenSelectedCommand}" />
                        <Button Content="{l:Loc Action.ShareGroup}" Command="{Binding ShareScreenGroupCommand}" />
                        <Button Content="{l:Loc Action.OpenApp}" Command="{Binding OpenApplicationCommand}" />
                        <Button Content="{l:Loc Action.CloseApp}" Command="{Binding CloseApplicationCommand}" />
                        <Button Content="{l:Loc Action.Restart}" Command="{Binding RestartCommand}" Style="{StaticResource DangerButton}" />
                        <Button Content="{l:Loc Action.Shutdown}" Command="{Binding ShutdownCommand}" Style="{StaticResource DangerButton}" />
                        <Separator Margin="0,6" />
                        <Button Content="{l:Loc Action.Approve}" Command="{Binding ApproveCommand}" />
                        <Button Content="{l:Loc Action.Reject}" Command="{Binding RejectCommand}" />
                        <Button Content="{l:Loc Action.Rename}" Command="{Binding RenameCommand}" />
                        <Button Content="{l:Loc Action.MoveToGroup}" Click="MoveToGroup_Click" />
                        <Button Content="{l:Loc Action.Remove}" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}" />
                        <Separator Margin="0,6" />
                        <Button Content="{l:Loc Action.SelectAll}" Command="{Binding SelectAllCommand}" />
                        <Button Content="{l:Loc Action.ClearSelection}" Command="{Binding ClearSelectionCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                    <Run Text="{l:Loc Status.Code}" /> <Run Text="{Binding ClassroomCode, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
