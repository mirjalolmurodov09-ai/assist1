<Window x:Class="ClassroomControl.TeacherApp.Views.ScreenshotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClassroomControl.TeacherApp"
        Title="{l:Loc Shots.Title}" Width="860" Height="520" MinWidth="640" MinHeight="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Shots.Title}" FontSize="20" FontWeight="Bold" />
        <Grid Grid.Row="1" Margin="8,12,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{l:Loc Shots.Time}" Style="{StaticResource Muted}" />
            <TextBlock Grid.Column="1" Text="{l:Loc Shots.Student}" Style="{StaticResource Muted}" />
            <TextBlock Grid.Column="2" Text="{l:Loc Shots.Computer}" Style="{StaticResource Muted}" />
            <TextBlock Grid.Column="3" Text="{l:Loc Shots.File}" Style="{StaticResource Muted}" />
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="List_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Time}" />
                        <TextBlock Grid.Column="1" Text="{Binding StudentName}" />
                        <TextBlock Grid.Column="2" Text="{Binding ComputerName}" />
                        <TextBlock Grid.Column="3" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Loc Shots.Open}" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Shots.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Logs.Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <Button Content="{l:Loc Common.Close}" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
